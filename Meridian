<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Meridian Interiors – Interior design for homes and offices</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@500;700;800&family=Instrument+Sans:wght@400;500;600&display=swap">
<style>
:root{--bg:#f4f7f6;--surface:#fff;--ink:#14212b;--muted:#516069;--line:#d3dcda;--brand:#2b6b66;--brand-ink:#fff;--accent:#e0b64f;--err:#b3261e;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0f1a1f;--surface:#17262d;--ink:#eaf1ef;--muted:#9db0ac;--line:#2a3d44;--brand:#6fc0b8;--brand-ink:#0f1a1f;--accent:#e0b64f;--err:#ff8a80}}
:root[data-theme="dark"]{--bg:#0f1a1f;--surface:#17262d;--ink:#eaf1ef;--muted:#9db0ac;--line:#2a3d44;--brand:#6fc0b8;--brand-ink:#0f1a1f;--accent:#e0b64f;--err:#ff8a80}
*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:70px}
body{margin:0;background:var(--bg);color:var(--ink);font:400 1.0625rem/1.6 "Instrument Sans",system-ui,sans-serif}
h1,h2,h3{font-family:"Bricolage Grotesque","Instrument Sans",system-ui,sans-serif;line-height:1.1;margin:0;letter-spacing:-.02em}
a{color:inherit}
.wrap{max-width:1080px;margin:0 auto;padding:0 20px}
header{position:sticky;top:0;z-index:5;background:var(--bg);border-bottom:1px solid var(--line)}
header .wrap{display:flex;align-items:center;justify-content:space-between;height:60px;gap:16px}
.logo{font:800 1.2rem "Bricolage Grotesque",sans-serif;text-decoration:none}
.logo span{color:var(--brand)}
nav{display:flex;gap:20px;align-items:center;font-size:.95rem}
nav a{text-decoration:none;color:var(--muted)}
nav a:hover,nav a:focus-visible{color:var(--ink)}
@media(max-width:640px){nav a.hide{display:none}}
.btn{display:inline-block;background:var(--brand);color:var(--brand-ink);border:0;border-radius:8px;padding:12px 22px;font:600 1rem "Instrument Sans",sans-serif;cursor:pointer;text-decoration:none}
.btn:hover{filter:brightness(1.08)}
:focus-visible{outline:3px solid var(--accent);outline-offset:2px}
.hero{display:grid;grid-template-columns:1.1fr .9fr;gap:48px;padding:64px 0 72px;align-items:start}
@media(max-width:820px){.hero{grid-template-columns:1fr;gap:32px;padding:40px 0}}
.hero h1{font-size:clamp(2.4rem,6vw,4rem);font-weight:800}
.hero p.lead{font-size:1.2rem;color:var(--muted);max-width:34em;margin:20px 0 24px}
.stats{display:flex;gap:28px;flex-wrap:wrap;margin:0;padding:0;list-style:none;color:var(--muted);font-size:.95rem}
.stats b{display:block;color:var(--ink);font:700 1.5rem "Bricolage Grotesque",sans-serif}
form{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:26px;border-top:5px solid var(--accent)}
form h2{font-size:1.5rem;margin-bottom:4px}
form .sub{margin:0 0 18px;color:var(--muted);font-size:.95rem}
label{display:block;font-weight:600;font-size:.92rem;margin:14px 0 5px}
input,select,textarea{width:100%;font:inherit;color:var(--ink);background:var(--bg);border:1px solid var(--line);border-radius:8px;padding:10px 12px}
textarea{min-height:90px;resize:vertical}
.row{display:grid;grid-template-columns:1fr 1fr;gap:12px}
@media(max-width:480px){.row{grid-template-columns:1fr}}
.err{color:var(--err);font-size:.85rem;min-height:1.1em;margin:3px 0 0}
input[aria-invalid="true"],select[aria-invalid="true"]{border-color:var(--err)}
form .btn{width:100%;margin-top:18px}
.ok{display:none;background:var(--surface);border:1px solid var(--brand);border-radius:14px;padding:26px}
.ok.show{display:block}
section{padding:64px 0;border-top:1px solid var(--line)}
section h2{font-size:clamp(1.8rem,4vw,2.5rem);margin-bottom:12px}
section>.wrap>p.intro{color:var(--muted);max-width:36em;margin:0 0 36px}
.svc{display:grid;grid-template-columns:200px 1fr auto;gap:8px 28px;padding:20px 0;border-top:1px solid var(--line);align-items:baseline}
.svc:last-child{border-bottom:1px solid var(--line)}
.svc h3{font-size:1.3rem}
.svc p{margin:0;color:var(--muted)}
.svc .price{font-weight:600;white-space:nowrap}
@media(max-width:700px){.svc{grid-template-columns:1fr}}
ol.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:28px;margin:0;padding:0;list-style:none;counter-reset:s}
@media(max-width:760px){ol.steps{grid-template-columns:1fr}}
ol.steps li{counter-increment:s;padding-top:14px;border-top:4px solid var(--brand)}
ol.steps li::before{content:"Step " counter(s);font-weight:600;color:var(--brand);font-size:.9rem}
ol.steps h3{font-size:1.25rem;margin:4px 0 6px}
ol.steps p{margin:0;color:var(--muted)}
blockquote{margin:0;max-width:40em;font:500 clamp(1.3rem,3vw,1.8rem)/1.3 "Bricolage Grotesque",sans-serif}
cite{display:block;margin-top:14px;font:400 .95rem "Instrument Sans",sans-serif;color:var(--muted)}
details{border-top:1px solid var(--line);padding:16px 0}
details:last-of-type{border-bottom:1px solid var(--line)}
summary{cursor:pointer;font-weight:600;font-size:1.05rem}
details p{margin:10px 0 0;color:var(--muted);max-width:42em}
footer{border-top:1px solid var(--line);padding:32px 0;color:var(--muted);font-size:.95rem}
footer .wrap{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
/* Polished, editorial finish */
:root{--bg:#f5f2eb;--surface:#fffdf8;--ink:#20302d;--muted:#65736e;--line:#d9ddd5;--brand:#386c5a;--brand-ink:#fff;--accent:#d9a747}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#101a18;--surface:#1a2925;--ink:#edf2ed;--muted:#a8b8af;--line:#31423d;--brand:#85b9a0;--brand-ink:#12201b;--accent:#e5bb69}}
:root[data-theme="dark"]{--bg:#101a18;--surface:#1a2925;--ink:#edf2ed;--muted:#a8b8af;--line:#31423d;--brand:#85b9a0;--brand-ink:#12201b;--accent:#e5bb69}
body{background-image:radial-gradient(ellipse at 8% 9%,rgba(217,167,71,.10),transparent 30%),radial-gradient(ellipse at 95% 28%,rgba(56,108,90,.08),transparent 28%)}
header{backdrop-filter:blur(16px);background:color-mix(in srgb,var(--bg) 88%,transparent)}
.logo{font-size:1.35rem;letter-spacing:-.04em}
.btn{box-shadow:0 8px 18px rgba(35,70,57,.15);transition:transform .2s ease,box-shadow .2s ease,filter .2s ease}
.btn:hover{transform:translateY(-2px);box-shadow:0 12px 24px rgba(35,70,57,.2)}
.hero{padding-top:76px;padding-bottom:82px;align-items:center}
.hero>div:first-child{position:relative;padding:34px 30px 30px 0}
.hero>div:first-child:before{content:"";position:absolute;z-index:-1;width:270px;height:270px;right:2%;top:8%;border-radius:50%;background:radial-gradient(circle at 35% 35%,rgba(217,167,71,.23),rgba(56,108,90,.09) 58%,transparent 70%)}
.eyebrow{margin:0 0 14px;color:var(--brand);font-size:.78rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase}
.hero h1{max-width:10ch;font-size:clamp(3rem,7vw,5.25rem);letter-spacing:-.055em}
.hero p.lead{font-size:1.16rem;line-height:1.7;max-width:31em}
.stats{gap:12px}
.stats li{padding:10px 15px;background:var(--surface);border:1px solid var(--line);border-radius:12px;font-size:.85rem}
.stats b{font-size:1.35rem}
form,.ok{box-shadow:0 22px 55px rgba(34,52,44,.09);border-radius:18px;padding:30px}
form{border-top-width:6px}
input,select,textarea{transition:border-color .2s ease,box-shadow .2s ease}
input:focus,select:focus,textarea:focus{outline:0;border-color:var(--brand);box-shadow:0 0 0 3px color-mix(in srgb,var(--brand) 18%,transparent)}
section{padding:76px 0}
section h2{letter-spacing:-.04em}
.svc{grid-template-columns:minmax(145px,.7fr) 1.5fr auto;gap:10px 24px;padding:23px 24px;margin:12px 0;background:var(--surface);border:1px solid var(--line);border-radius:14px;transition:transform .2s ease,border-color .2s ease,box-shadow .2s ease}
.svc:last-child{border-bottom:1px solid var(--line)}
.svc:hover{transform:translateY(-3px);border-color:var(--brand);box-shadow:0 12px 28px rgba(34,52,44,.08)}
.svc .price{color:var(--brand)}
ol.steps li{padding:18px 18px 20px;background:var(--surface);border:1px solid var(--line);border-top:4px solid var(--brand);border-radius:4px 4px 14px 14px}
blockquote{max-width:unset;padding:38px 42px;border-radius:18px;background:var(--surface);border-left:5px solid var(--accent);box-shadow:0 15px 38px rgba(34,52,44,.06)}
summary{transition:color .2s ease}summary:hover{color:var(--brand)}
.theme-toggle{background:transparent;color:var(--ink);border:1px solid var(--line);border-radius:999px;padding:8px 12px;font:600 .9rem "Instrument Sans",sans-serif;cursor:pointer}
.theme-toggle:hover{border-color:var(--brand);color:var(--brand)}
@media(max-width:700px){.svc{grid-template-columns:1fr;gap:6px}.svc .price{white-space:normal}.hero>div:first-child{padding-right:0}.hero{padding-top:48px}}
.gallery{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}
.gallery-card{overflow:hidden;background:var(--surface);border:1px solid var(--line);border-radius:16px;box-shadow:0 12px 30px rgba(34,52,44,.07);transition:transform .2s ease,box-shadow .2s ease}
.gallery-card:hover{transform:translateY(-5px);box-shadow:0 18px 38px rgba(34,52,44,.13)}
.gallery-card svg{display:block;width:100%;height:auto;aspect-ratio:4/3}
.gallery-card figcaption{padding:16px 18px 18px}
.gallery-card h3{font-size:1.2rem;margin-bottom:5px}
.gallery-card p{margin:0;color:var(--muted);font-size:.95rem}
@media(max-width:760px){.gallery{grid-template-columns:1fr 1fr}}
@media(max-width:520px){.gallery{grid-template-columns:1fr}}
@media(max-width:480px){form,.ok{padding:22px}.stats{gap:8px}.stats li{padding:8px 10px}blockquote{padding:26px 24px}nav{gap:10px}.theme-toggle{padding:8px 10px}}
@media(prefers-reduced-motion:reduce){.btn,.svc,input,select,textarea{transition:none}}
</style>
</head>
