(function(){
var f=document.getElementById('quote'),ok=document.getElementById('ok');
function setErr(id,m){var e=f.querySelector('[data-for="'+id+'"]'),i=document.getElementById(id);if(e)e.textContent=m;if(i)i.setAttribute('aria-invalid',m?'true':'false')}
f.addEventListener('submit',function(ev){
ev.preventDefault();
var n=f.name.value.trim(),em=f.email.value.trim(),t=f.type.value,bad=0;
setErr('name',n?'':'Enter your name.');if(!n)bad=1;
var okEm=/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(em);
setErr('email',okEm?'':'Enter a valid email, like name@example.com.');if(!okEm)bad=1;
setErr('type',t?'':'Choose a project type.');if(!t)bad=1;
if(bad){var first=f.querySelector('[aria-invalid="true"]');if(first)first.focus();return}
document.getElementById('okmsg').textContent='Thanks, '+n.split(' ')[0]+'. We’ll email you at '+em+' within two working days.';
f.style.display='none';ok.classList.add('show');ok.focus();
});
document.getElementById('again').addEventListener('click',function(){f.reset();f.style.display='';ok.classList.remove('show');f.name.focus()});
var themeButton=document.getElementById('themeToggle');
themeButton.addEventListener('click',function(){
var current=document.documentElement.dataset.theme;
var systemDark=window.matchMedia&&window.matchMedia('(prefers-color-scheme: dark)').matches;
var next=current==='dark'?'light':current==='light'?'dark':systemDark?'light':'dark';
document.documentElement.dataset.theme=next;
themeButton.setAttribute('aria-pressed',next==='dark'?'true':'false');
themeButton.textContent=next==='dark'?'☀ Light':'☾ Dark';
themeButton.setAttribute('aria-label','Switch to '+(next==='dark'?'light':'dark')+' theme');
});
})();
</script>
</body>
</html>
